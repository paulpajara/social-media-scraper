# Credential placeholders are intentionally blank: no API is called until configured.
# Copy this file to .env locally and fill only the sources you can access.
# Never commit real credentials or put them into notebook cells/config files.

# Reddit OAuth application credentials and identifying User-Agent.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="python:ph-government-sentiment:0.1.0 (contact: https://github.com/paulpajara/social-media-scraper)"

# X developer access; full-year data require full-archive search entitlement.
X_BEARER_TOKEN=

# Threads app token with the threads_keyword_search permission.
THREADS_ACCESS_TOKEN=

# Facebook Page token/public-content access; also configure Page IDs and API version.
FACEBOOK_ACCESS_TOKEN=
