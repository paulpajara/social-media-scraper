# Credential placeholders are intentionally blank: X/Threads require configuration.
# Copy this file to .env locally only if a configured .env does not already exist.
# Never commit real credentials or put them into notebook cells/config files.

# X developer access; full-year data require full-archive search entitlement.
X_BEARER_TOKEN=

# Threads user access token with approved threads_keyword_search permission.
THREADS_ACCESS_TOKEN=

# Bluesky and Mastodon use public endpoints; no credentials are required.
